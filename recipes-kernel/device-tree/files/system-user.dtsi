/* SchneiOS TE0726 Linux-specific configuration.
 * Include AFTER zynq-7000.dtsi, pl.dtsi and pcw.dtsi.
 * Do not include system-conf.dtsi here.
 */

/ {
    #address-cells = <1>;
    #size-cells = <1>;

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        hdmi_fb_reserved_region: framebuffer@1fc00000 {
            compatible = "shared-dma-pool";
            no-map;
            reg = <0x1fc00000 0x00400000>;
        };
    };

    hdmi_fb: framebuffer@1fc00000 {
        compatible = "simple-framebuffer";
        reg = <0x1fc00000 (1280 * 720 * 4)>;
        width = <1280>;
        height = <720>;
        stride = <(1280 * 4)>;
        format = "a8b8g8r8";
        status = "okay";
    };

    vcc_3V3: fixedregulator {
        compatible = "regulator-fixed";
        regulator-name = "vccaux-supply";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        regulator-always-on;
    };

    usb_phy0: usb-phy@e0002000 {
        compatible = "ulpi-phy";
        #phy-cells = <0>;
        reg = <0xe0002000 0x1000>;
        view-port = <0x0170>;
        drv-vbus;
    };

    playback_codec: playback-codec {
        compatible = "linux,spdif-dit";
        #sound-dai-cells = <0>;
    };

    record_codec: record-codec {
        compatible = "linux,spdif-dir";
        #sound-dai-cells = <0>;
    };

    sound {
        compatible = "simple-audio-card";
        #address-cells = <1>;
        #size-cells = <0>;

        simple-audio-card,widgets =
            "Microphone", "In Jack",
            "Line", "Line In Jack",
            "Line", "Line Out Jack",
            "Headphone", "Out Jack";

        simple-audio-card,routing =
            "Out Jack", "te-out",
            "te-in", "In Jack";

        playback_link: simple-audio-card,dai-link@0 {
            reg = <0>;
            format = "i2s";
            bitclock-master = <&p_codec_dai>;
            frame-master = <&p_codec_dai>;

            p_cpu_dai: cpu {
                sound-dai = <&audio_i2s_transmitter_0>;
            };
            p_platform_dai: plat {
                sound-dai = <&audio_audio_formatter_0>;
            };
            p_codec_dai: codec {
                sound-dai = <&playback_codec>;
            };
        };

        record_link: simple-audio-card,dai-link@1 {
            reg = <1>;
            format = "i2s";
            bitclock-master = <&r_codec_dai>;
            frame-master = <&r_codec_dai>;

            r_cpu_dai: cpu {
                sound-dai = <&audio_i2s_receiver_0>;
            };
            r_platform_dai: plat {
                sound-dai = <&audio_audio_formatter_0>;
            };
            r_codec_dai: codec {
                sound-dai = <&record_codec>;
            };
        };
    };
};

&qspi {
    #address-cells = <1>;
    #size-cells = <0>;
    status = "okay";

    flash0: flash@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        #address-cells = <1>;
        #size-cells = <1>;
        spi-rx-bus-width = <4>;
        spi-tx-bus-width = <4>;
        spi-max-frequency = <40000000>;
    };
};

/* Hardware is initialized by FSBL; do not let Linux reconfigure VDMA. */
&video_in_axi_vdma_0 { status = "disabled"; };
&video_out_axi_vdma_0 { status = "disabled"; };
&video_out_v_tc_0 { status = "disabled"; };

&gpio0 {
    interrupt-controller;
    #interrupt-cells = <2>;
};

&i2c1 {
    #address-cells = <1>;
    #size-cells = <0>;

    i2cmux0: i2c-mux@70 {
        compatible = "nxp,pca9544";
        #address-cells = <1>;
        #size-cells = <0>;
        reg = <0x70>;

        i2c@0 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0>;
            id_eeprom: eeprom@50 {
                compatible = "atmel,24c32";
                reg = <0x50>;
            };
        };
        i2c@1 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <1>;
        };
        i2c@2 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <2>;
        };
        i2c@3 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <3>;
        };
    };
};

&usb0 {
    usb-phy = <&usb_phy0>;
};

/* Reuse the hardware nodes provided by pl.dtsi, without duplicating reg/IRQ/clocks. */
&audio_audio_formatter_0 {
    #sound-dai-cells = <0>;
    status = "okay";
};
&audio_i2s_receiver_0 {
    #sound-dai-cells = <0>;
    status = "okay";
};
&audio_i2s_transmitter_0 {
    #sound-dai-cells = <0>;
    status = "okay";
};

/* The counter at 0x43c60000 is already defined in pl.dtsi. */

/* Reserve XADC for the existing audio-recording use case. */
&adc { status = "disabled"; };

/*-------------------- EARLY LINUX BOOT FIXES --------------------*/
/* SDTGen's board-only root compatible overrides zynq-7000.dtsi.
 * Keep both the specific board identity and the generic Zynq-7000 match.
 */
/ {
    compatible = "xlnx,te0726_10_1c", "xlnx,zynq-7000";

    chosen {
        stdout-path = "serial0:115200n8";
        bootargs = "console=ttyPS0,115200 earlycon root=/dev/ram0 rw loglevel=8 ignore_loglevel";
    };
};

/* The address-map below is hardware-generation metadata and references
 * the four generated memory nodes. Linux does not need this property.
 * Remove it before replacing those nodes with the proper Linux RAM map.
 */
&cpus_a9 {
    /delete-property/ address-map;
};

/* Do not present QSPI's linear window or PS OCM as general-purpose RAM. */
/delete-node/ &ps7_qspi_linear_0_memory;
/delete-node/ &ps7_ddr_0_memory;
/delete-node/ &ps7_ram_0_memory;
/delete-node/ &ps7_ram_1_memory;

/* Same RAM layout as the previously booting DTB: 512 MiB starting at zero.
 * The framebuffer's last 4 MiB remain reserved by the reserved-memory
 * section above.
 */
/ {
    memory@0 {
        device_type = "memory";
        reg = <0x00000000 0x20000000>;
    };
};
